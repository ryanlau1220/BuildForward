#   cp .env.production.example .env.production

# Public origin where the browser reaches the API. Baked into the web build.
NEXT_PUBLIC_API_URL=https://buildforward.duckdns.org

# Browser origin(s) allowed to call the API (CORS). Comma-separate multiples.
CORS_ORIGINS=https://buildforward.duckdns.org

# Host port binding (what NPM proxies to)
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1

# PostgreSQL
# Use a strong, unique password. Generate one with:  openssl rand -base64 24
POSTGRES_DB=buildforward
POSTGRES_USER=buildforward
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
