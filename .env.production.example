# Copy to .env.production on the VPS and fill in real values.
#   cp .env.production.example .env.production
# .env.production is git-ignored and must never be committed.

# ---------------------------------------------------------------------------
# Public URLs (TLS is handled by Nginx Proxy Manager, not this stack)
# ---------------------------------------------------------------------------

# Public origin where the browser reaches the API. Baked into the web build.
# IMPORTANT: the scheme (http/https) MUST match how NPM serves the site.
# If the page is served over https, this must be https too, or the browser
# blocks the API calls as mixed content.
#   Option A (single hostname, recommended): https://buildforward.duckdns.org
#   Option B (separate api host):            https://api.buildforward.duckdns.org
NEXT_PUBLIC_API_URL=https://buildforward.duckdns.org

# Browser origin(s) allowed to call the API (CORS). Comma-separate multiples.
# For the single-hostname setup this is just your app domain.
CORS_ORIGINS=https://buildforward.duckdns.org

# ---------------------------------------------------------------------------
# Host port binding (what NPM proxies to)
# ---------------------------------------------------------------------------
# Bind published ports to loopback so they are not exposed publicly; NPM on the
# same host proxies them. If NPM runs as a container without host networking,
# set these to 0.0.0.0 (and firewall the ports) or attach NPM to this stack's
# network instead.
WEB_BIND=127.0.0.1
API_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Use a strong, unique password. Generate one with:  openssl rand -base64 24
POSTGRES_DB=buildforward
POSTGRES_USER=buildforward
POSTGRES_PASSWORD=CHANGE_ME_use_a_strong_password
